{
  "permissions": {
    "ask": [
      "Edit(/.agents/permissions.json)",
      "Edit(/.agents/core/**)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/**/.venv)",
      "Edit(/**/.venv/**)",
      "Edit(/**/.python-version)",
      "Bash(uv venv)",
      "Bash(uv venv *)",
      "Bash(git config user.email)",
      "Bash(git config user.email *)",
      "Bash(git config user.name)",
      "Bash(git config user.name *)",
      "Edit(/.agents/local/team.json)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch)",
      "Bash(git filter-branch *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets.toml)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(git push --no-verify)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath)",
      "Bash(git config core.hooksPath *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/core/hooks/guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/core/bin/py\" -I \"$CLAUDE_PROJECT_DIR/.agents/core/hooks/session_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/core/bin/py\" -I \"$CLAUDE_PROJECT_DIR/.agents/core/hooks/review_tick.py\""
          }
        ]
      }
    ]
  }
}
