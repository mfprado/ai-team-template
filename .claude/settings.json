{
  "permissions": {
    "ask": [
      "Edit(/.agents/permissions.json)",
      "Edit(/.agents/core/**)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch)",
      "Bash(git filter-branch *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets.toml)",
      "Read(*.pem)",
      "Read(*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/core/hooks/guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/core/hooks/session_start.py\""
          }
        ]
      }
    ]
  }
}
