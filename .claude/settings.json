{
  "permissions": {
    "allow": [
      "Bash(TEAM_PAGE_NO_BROWSER=1 uv run --quiet --no-project --python 3.12 --with streamlit==1.41.1 .agents/system/facade/page.py)",
      "Bash(TEAM_PAGE_NO_BROWSER=1 uv run --quiet --no-project --python 3.12 --with streamlit==1.41.1 .agents/system/facade/page.py *)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/propose_change.py)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/propose_change.py *)",
      "Bash(sh .agents/system/bin/py .agents/system/scripts/sync.py)",
      "Bash(sh .agents/system/bin/py .agents/system/scripts/sync.py *)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/new_artifact.py)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/new_artifact.py *)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/artifact_link.py)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/artifact_link.py *)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/ideas.py)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/ideas.py *)",
      "Bash(sh .agents/system/bin/setup)",
      "Bash(sh .agents/system/bin/setup *)",
      "Bash(sh .agents/system/bin/team-page)",
      "Bash(sh .agents/system/bin/team-page *)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/doctor.py)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/doctor.py *)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/selftest.py)",
      "Bash(sh .agents/system/bin/py -I .agents/system/scripts/selftest.py *)",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__computer"
    ],
    "ask": [
      "Edit(/.agents/permissions.json)",
      "Edit(/.agents/system/**)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/**/.venv)",
      "Edit(/**/.venv/**)",
      "Edit(/**/.python-version)",
      "Bash(uv venv)",
      "Bash(uv venv *)",
      "Bash(git config user.email)",
      "Bash(git config user.email *)",
      "Bash(git config user.name)",
      "Bash(git config user.name *)",
      "Edit(/.agents/team.json)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch)",
      "Bash(git filter-branch *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets.toml)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(git push --no-verify)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath)",
      "Bash(git config core.hooksPath *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/system/hooks/guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/system/bin/py\" -I \"$CLAUDE_PROJECT_DIR/.agents/system/hooks/session_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/system/bin/py\" -I \"$CLAUDE_PROJECT_DIR/.agents/system/hooks/review_tick.py\""
          }
        ]
      }
    ]
  }
}
