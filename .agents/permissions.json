{
  "version": 1,
  "description": "What the AI may not do in this repository. Source of truth: sync.py turns it into .claude/settings.json and .codex/rules, and the guard hook enforces it before every tool call. Format modelled on agent-perms (tool / pattern / tier); \"unless\" lists tool-name globs exempt from a rule (e.g. drafts).",
  "rules": [
    { "tool": "Bash", "pattern": "git push --force", "tier": "deny", "reason": "Force-pushing rewrites shared history." },
    { "tool": "Bash", "pattern": "git push -f", "tier": "deny", "reason": "Force-pushing rewrites shared history." },
    { "tool": "Bash", "pattern": "git push --force-with-lease", "tier": "deny", "reason": "Force-pushing rewrites shared history." },
    { "tool": "Bash", "pattern": "git reset --hard", "tier": "deny", "reason": "Discards work that cannot be recovered." },
    { "tool": "Bash", "pattern": "git filter-branch", "tier": "deny", "reason": "Rewrites history." },

    { "tool": "Read", "pattern": "**/.env", "tier": "deny", "reason": "Secrets file." },
    { "tool": "Read", "pattern": "**/.env.*", "tier": "deny", "reason": "Secrets file." },
    { "tool": "Read", "pattern": "**/secrets.toml", "tier": "deny", "reason": "Secrets file." },
    { "tool": "Read", "pattern": "**/*.pem", "tier": "deny", "reason": "Private key." },
    { "tool": "Read", "pattern": "**/*.key", "tier": "deny", "reason": "Private key." },

    { "tool": "mcp__*send*", "unless": ["*draft*"], "tier": "deny", "reason": "Messages are drafted, never sent by the AI." },
    { "tool": "mcp__*schedule*", "unless": ["*draft*"], "tier": "deny", "reason": "Scheduling a message is sending it." },
    { "tool": "mcp__*post_message*", "unless": ["*draft*"], "tier": "deny", "reason": "Messages are drafted, never sent by the AI." },
    { "tool": "mcp__*reply*", "unless": ["*draft*"], "tier": "deny", "reason": "Messages are drafted, never sent by the AI." },
    { "tool": "mcp__*forward*", "unless": ["*draft*"], "tier": "deny", "reason": "Messages are drafted, never sent by the AI." }
  ]
}
