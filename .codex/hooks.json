{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)\"/.agents/system/hooks/guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)\"/.agents/system/bin/py -I \"$(git rev-parse --show-toplevel)\"/.agents/system/hooks/session_start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)\"/.agents/system/bin/py -I \"$(git rev-parse --show-toplevel)\"/.agents/system/hooks/review_tick.py"
          }
        ]
      }
    ]
  }
}
