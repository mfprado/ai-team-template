prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-pushing rewrites shared history.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force-pushing rewrites shared history.",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "Force-pushing rewrites shared history.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Discards work that cannot be recovered.",
)

prefix_rule(
    pattern = ["git", "filter-branch"],
    decision = "forbidden",
    justification = "Rewrites history.",
)

prefix_rule(
    pattern = ["uv", "venv"],
    decision = "prompt",
    justification = "Could change how the team checks work.",
)

prefix_rule(
    pattern = ["git", "push", "--no-verify"],
    decision = "forbidden",
    justification = "Skips the team checks.",
)

prefix_rule(
    pattern = ["git", "commit", "--no-verify"],
    decision = "forbidden",
    justification = "Skips the team checks.",
)

prefix_rule(
    pattern = ["git", "commit", "-n"],
    decision = "forbidden",
    justification = "Skips the team checks.",
)

prefix_rule(
    pattern = ["git", "config", "core.hooksPath"],
    decision = "forbidden",
    justification = "Turns off the team checks.",
)

prefix_rule(
    pattern = ["git", "config", "user.email"],
    decision = "prompt",
    justification = "Changes whose name the team's changes are saved under.",
)

prefix_rule(
    pattern = ["git", "config", "user.name"],
    decision = "prompt",
    justification = "Changes whose name the team's changes are saved under.",
)

prefix_rule(
